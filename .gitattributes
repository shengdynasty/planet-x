# Every checkout gets LF, whatever core.autocrlf says: the suites read sources byte for byte and Chrome serves the files
# as they are.
* text=auto eol=lf

# Images and fonts are never line-ending converted.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
# HD sky tiles are binary data: never convert line endings
app/assets/skytiles/** -text
